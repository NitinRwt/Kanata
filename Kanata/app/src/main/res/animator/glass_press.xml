<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle "pushed into the glass" feedback for pressable glass surfaces -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="@integer/glass_press_duration" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleX" android:valueTo="@dimen/glass_press_scale" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/glass_press_duration" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:valueTo="@dimen/glass_press_scale" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="@integer/glass_press_duration" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="@integer/glass_press_duration" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
