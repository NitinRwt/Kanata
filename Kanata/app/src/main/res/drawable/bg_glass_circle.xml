<?xml version="1.0" encoding="utf-8"?>
<!-- Static liquid glass surface: frosted fill, top sheen, dark outer + light inner hairline. Generated from glass_tokens -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_tint_static" />
            
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:centerY="0.4"
                android:startColor="@color/glass_highlight"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent" />
            
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="@dimen/glass_border_width" android:color="@color/glass_border" />
            
        </shape>
    </item>
    <item android:bottom="@dimen/glass_border_width" android:left="@dimen/glass_border_width" android:right="@dimen/glass_border_width" android:top="@dimen/glass_border_width">
        <shape android:shape="oval">
            <stroke android:width="0.5dp" android:color="@color/glass_border_highlight" />
            
        </shape>
    </item>
</layer-list>
