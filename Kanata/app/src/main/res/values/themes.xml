<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Base" parent="Theme.Material3.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/status</item>

        <item name="colorPrimary">@color/pink_500</item>
        <item name="colorPrimaryVariant">@color/pink_700</item>
        <item name="colorOnPrimary">@color/bg_white</item>
        <item name="colorSecondary">@color/violet_400</item>
        <item name="colorSecondaryVariant">@color/violet_700</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        <item name="colorSecondaryContainer">?attr/colorSecondary</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSecondary</item>
        <item name="colorOnSurfaceVariant">@color/nav_tab</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/bg_black</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearanceOverlay.Demo</item>
        <item name="android:ambientShadowAlpha">0.08</item>
        <item name="android:spotShadowAlpha">0.08</item>
        <item name="snackbarStyle">@style/MySnackbar</item>
        <item name="snackbarButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Snackbar</item>
        <item name="snackbarTextViewStyle">@string/MySnackBarText</item>
        <item name="popupMenuStyle">@style/MyPopup</item>

        <!-- Liquid glass -->
        <item name="glassCardStyle">@style/Widget.Kanata.Glass.Card</item>
        <item name="glassButtonStyle">@style/Widget.Kanata.Glass.Button</item>
        <item name="chipStyle">@style/Widget.Kanata.Glass.Chip</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Kanata.Glass.BottomSheetDialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.Kanata.Screen</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">1000</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/anim_splash</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <style name="Theme.Kanata" parent="Theme.Base">
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Kanata.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Kanata.AppBarOverlay" parent="Theme.Kanata" />
    <style name="Theme.Kanata.PopupOverlay" parent="Theme.Kanata" />

    <style name="Theme.Kanata.NeverCutout" parent="@style/Theme.Kanata.NoActionBar">
        <item name="android:navigationBarColor">@color/nav_bg</item>
    </style>

    <style name="Base.DialogTheme" parent="Theme.Kanata">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/bg_glass_dialog</item>
        <item name="android:backgroundDimAmount">0.42</item>
    </style>

    <!-- values-v31 adds the native blur behind dialogs -->
    <style name="DialogTheme" parent="Base.DialogTheme" />

    <!--TV Themes-->
    <style name="Theme.KanataTV" parent="Theme.Leanback">
        <item name="android:statusBarColor">@color/status</item>
        <item name="colorPrimary">@color/pink_200</item>
        <item name="colorPrimaryVariant">@color/pink_700</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        <item name="colorSecondary">@color/violet_400</item>
        <item name="colorSecondaryVariant">@color/violet_400</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        <item name="colorSecondaryContainer">?attr/colorSecondary</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSecondary</item>
        <item name="colorOnSurfaceVariant">@color/nav_tab</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/bg_white</item>
    </style>

    <style name="TVDialogTheme" parent="Theme.Leanback">
        <item name="colorPrimary">@color/pink_200</item>
        <item name="colorPrimaryVariant">@color/pink_700</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        <item name="colorSecondary">@color/violet_400</item>
        <item name="colorSecondaryVariant">@color/violet_400</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        <item name="android:textColor">@color/bg_white</item>

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/cardview_dark_background</item>
    </style>

    <style name="QualitySelectorDialogTheme" parent="DialogTheme">
        <item name="colorPrimary">@color/pink_200</item>
        <item name="colorPrimaryVariant">@color/pink_700</item>
        <item name="colorOnPrimary">@color/bg_black</item>
        <item name="colorSecondary">@color/violet_400</item>
        <item name="colorSecondaryVariant">@color/violet_400</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        <item name="android:textColor">@color/bg_white</item>

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/cardview_dark_background</item>
    </style>

</resources>