<?xml version="1.0" encoding="utf-8"?>
<app.kanata.island.DynamicIslandView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="@dimen/glass_elevation"
    android:minHeight="@dimen/island_height"
    app:glassCornerRadius="@dimen/glass_radius_large"
    app:glassPressable="false">

    <LinearLayout
        android:id="@+id/islandContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/islandBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/islandWatch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/island_continue"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/islandCover"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/IslandCircle"
                    tools:ignore="ContentDescription"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/islandWatchRing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="1000"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="36dp"
                    app:trackColor="@color/glass_border"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="3dp"
                    tools:progress="600" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/islandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:maxWidth="@dimen/island_text_width"
                    android:singleLine="true"
                    android:textColor="@color/bg_opp"
                    android:textSize="12sp"
                    tools:text="Sousou no Frieren" />

                <TextView
                    android:id="@+id/islandSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false"
                    android:maxWidth="@dimen/island_text_width"
                    android:singleLine="true"
                    android:textColor="@color/bg_opp"
                    android:textSize="11sp"
                    tools:text="Downloading 3 / 12" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/islandDownload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/islandDownloadRing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="1000"
                    app:indicatorColor="?attr/colorSecondary"
                    app:indicatorSize="30dp"
                    app:trackColor="@color/glass_border"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="3dp"
                    tools:progress="300" />

                <ImageView
                    android:id="@+id/islandDownloadIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_round_download_24"
                    app:tint="@color/bg_opp"
                    tools:ignore="ContentDescription" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/islandExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/islandDownloadList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/islandDismiss"
                    style="@style/IslandAction"
                    android:text="@string/island_dismiss" />

                <TextView
                    android:id="@+id/islandDownloads"
                    style="@style/IslandAction"
                    android:text="@string/downloads" />

                <TextView
                    android:id="@+id/islandContinue"
                    style="@style/IslandAction"
                    android:text="@string/island_continue"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</app.kanata.island.DynamicIslandView>
