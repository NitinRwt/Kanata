<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="@string/reader_settings"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.58"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/theme" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/novelSettingsTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/novelThemeLight"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novel_theme_light" />

            <Button
                android:id="@+id/novelThemeSepia"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novel_theme_sepia" />

            <Button
                android:id="@+id/novelThemeDark"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novel_theme_dark" />

            <Button
                android:id="@+id/novelThemeBlack"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/novel_theme_black" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.58"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/font" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/novelSettingsFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/novelFontSans"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="@string/novel_font_sans" />

            <Button
                android:id="@+id/novelFontSerif"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="@string/novel_font_serif" />

            <Button
                android:id="@+id/novelFontPoppins"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:text="@string/novel_font_poppins" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/novelSettingsTextSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.58"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/text_size" />

        <com.google.android.material.slider.Slider
            android:id="@+id/novelSettingsTextSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="12"
            android:valueTo="32" />

        <TextView
            android:id="@+id/novelSettingsLineSpacingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.58"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/line_spacing" />

        <com.google.android.material.slider.Slider
            android:id="@+id/novelSettingsLineSpacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="1.0"
            android:valueTo="2.4" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/novelSettingsJustify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="56dp"
            android:text="@string/justify"
            app:thumbTint="@color/button_switch_track" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/novelSettingsKeepScreenOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="56dp"
            android:text="@string/keep_screen_on"
            app:thumbTint="@color/button_switch_track" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
