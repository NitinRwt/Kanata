<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/islandItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:singleLine="true"
            android:textColor="@color/bg_opp"
            android:textSize="12sp"
            tools:text="Sousou no Frieren" />

        <TextView
            android:id="@+id/islandItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.7"
            android:fontFamily="@font/poppins"
            android:textColor="@color/bg_opp"
            android:textSize="11sp"
            tools:text="3 / 12" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/islandItemProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="1000"
        app:indicatorColor="?attr/colorSecondary"
        app:trackColor="@color/glass_border"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp"
        tools:progress="250" />

    <TextView
        android:id="@+id/islandItemNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.7"
        android:fontFamily="@font/poppins"
        android:singleLine="true"
        android:textColor="@color/bg_opp"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="Fetching links 5 / 12"
        tools:visibility="visible" />
</LinearLayout>
