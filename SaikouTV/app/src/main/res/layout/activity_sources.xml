<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".settings.SourcesActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sourcesScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/sourcesContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="72dp"
                android:fontFamily="@font/poppins"
                android:text="@string/streaming_sources"
                android:textSize="32sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/streaming_sources_desc"
                android:textSize="14sp" />

            <TextView
                style="@style/Kamisama.SectionTitle"
                android:layout_marginStart="4dp"
                android:text="@string/built_in_sources" />

            <LinearLayout
                android:id="@+id/sourcesBuiltIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Kamisama.SectionTitle"
                android:layout_marginStart="4dp"
                android:text="@string/your_sources" />

            <LinearLayout
                android:id="@+id/sourcesCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/sourcesCustomEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:alpha="0.6"
                android:text="@string/your_sources_empty"
                android:textSize="14sp" />

            <ani.saikou.glass.GlassButton
                android:id="@+id/sourcesAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/add_source"
                app:icon="@drawable/ic_round_add_24" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ani.saikou.glass.GlassContainer
        android:id="@+id/sourcesClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_margin="12dp"
        android:contentDescription="@string/close"
        android:elevation="@dimen/glass_elevation"
        app:glassBlurTarget="@id/sourcesScroll"
        app:glassCornerRadius="@dimen/glass_radius_pill">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_round_close_24"
            tools:ignore="ContentDescription" />
    </ani.saikou.glass.GlassContainer>
</FrameLayout>
