<?xml version="1.0" encoding="utf-8"?>
<ani.saikou.glass.GlassCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sourceRowName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textSize="16sp"
                tools:text="HiAnime" />

            <TextView
                android:id="@+id/sourceRowLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                tools:text="https://hianime.ro" />

            <TextView
                android:id="@+id/sourceRowType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:textSize="12sp"
                tools:text="HiAnime theme · link changed" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            app:srcCompat="@drawable/ic_round_edit_24"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</ani.saikou.glass.GlassCard>
