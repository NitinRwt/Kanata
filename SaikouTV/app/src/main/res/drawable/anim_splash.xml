<?xml version="1.0" encoding="utf-8"?>
<!-- Kamisama logo animation: a torii gate assembles on a night disc, then the play button lights up in its doorway.
     768x768 canvas, drawn inside the 512 circle the Android 12 splash screen shows. Also the Settings logo. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="768dp"
            android:height="768dp"
            android:viewportWidth="768"
            android:viewportHeight="768">

            <!-- Night disc -->
            <group
                android:name="disc"
                android:pivotX="384"
                android:pivotY="384"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="@color/brand_ink"
                    android:pathData="M384,128a256,256 0,1 1,0 512a256,256 0,1 1,0 -512z" />
                <path
                    android:fillColor="@color/brand_ink_glow"
                    android:pathData="M384,206a178,178 0,1 1,0 356a178,178 0,1 1,0 -356z" />
            </group>

            <!-- Torii, drawn on a 108 grid and scaled 5.2x around the centre -->
            <group
                android:translateX="103.2"
                android:translateY="103.2"
                android:scaleX="5.2"
                android:scaleY="5.2">

                <!-- Pillars rise from the ground -->
                <group
                    android:name="pillars"
                    android:pivotY="76"
                    android:scaleY="0">
                    <path
                        android:fillColor="@color/brand_vermilion"
                        android:pathData="M37.5,40h5l1.3,36h-7.6z M65.5,40h5l1.3,36h-7.6z" />
                </group>

                <!-- Beams settle on top -->
                <group
                    android:name="beams"
                    android:translateY="-14">
                    <path
                        android:name="beams_path"
                        android:fillAlpha="0"
                        android:fillColor="@color/brand_vermilion"
                        android:pathData="M28,34C41,37.6 67,37.6 80,34L78.6,39.6C66,42.4 42,42.4 29.4,39.6Z M33.5,46h41v3.6h-41z M51.8,41h4.4v5h-4.4z" />
                </group>

                <!-- Play button in the doorway -->
                <group
                    android:name="play"
                    android:pivotX="54.5"
                    android:pivotY="63"
                    android:scaleX="0"
                    android:scaleY="0">
                    <path
                        android:fillColor="@color/brand_gold"
                        android:strokeColor="@color/brand_gold"
                        android:strokeLineJoin="round"
                        android:strokeWidth="2.4"
                        android:pathData="M50.5,55.5L60.5,63L50.5,70.5Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="disc">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="320" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" />
                <objectAnimator android:duration="320" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="pillars">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:startOffset="220" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="beams">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="320" android:interpolator="@android:interpolator/overshoot" android:propertyName="translateY" android:startOffset="440" android:valueFrom="-14" android:valueTo="0" />
        </aapt:attr>
    </target>

    <target android:name="beams_path">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="200" android:propertyName="fillAlpha" android:startOffset="440" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>

    <target android:name="play">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="300" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:startOffset="700" android:valueFrom="0" android:valueTo="1" />
                <objectAnimator android:duration="300" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:startOffset="700" android:valueFrom="0" android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
