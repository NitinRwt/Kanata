<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NavBarText">
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">2sp</item>
    </style>

    <style name="Suffix">
        <item name="android:height">54dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="text10sp">
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/poppins_family</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/glass_tint_sheet</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Kamisama.Glass.Sheet</item>
    </style>

    <!-- ─── Liquid glass components. All values come from glass_tokens ─── -->

    <style name="ShapeAppearance.Kamisama.Glass.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/glass_radius_large</item>
        <item name="cornerSizeTopRight">@dimen/glass_radius_large</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.Kamisama.Glass.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="Widget.Kamisama.Glass.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_tint_static</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">@dimen/glass_border_width</item>
        <item name="cardCornerRadius">@dimen/glass_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
        <item name="android:stateListAnimator">@animator/glass_press</item>
    </style>

    <style name="Widget.Kamisama.Glass.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_tint_static</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">@dimen/glass_border_width</item>
        <item name="cornerRadius">@dimen/glass_radius_pill</item>
        <item name="rippleColor">@color/glass_ripple</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@animator/glass_press</item>
    </style>

    <style name="Widget.Kamisama.Glass.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/glass_tint_static</item>
        <item name="boxStrokeColor">@color/glass_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/glass_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/glass_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/glass_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/glass_radius_small</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Kamisama.Glass.AutoComplete</item>
    </style>

    <!-- Same glass look for plain text fields: the style above is a dropdown and needs an AutoCompleteTextView -->
    <style name="Widget.Kamisama.Glass.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/glass_tint_static</item>
        <item name="boxStrokeColor">@color/glass_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/glass_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/glass_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/glass_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/glass_radius_small</item>
    </style>

    <!-- Dropdown popups of glass inputs get the frosted sheet tint -->
    <style name="ThemeOverlay.Kamisama.Glass.AutoComplete" parent="ThemeOverlay.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="autoCompleteTextViewStyle">@style/Widget.Kamisama.Glass.AutoComplete</item>
    </style>

    <style name="Widget.Kamisama.Glass.AutoComplete" parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">
        <item name="dropDownBackgroundTint">@color/glass_tint_sheet</item>
        <item name="android:popupElevation">@dimen/glass_elevation</item>
    </style>

    <style name="Widget.Kamisama.Glass.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/glass_chip_background</item>
        <item name="chipStrokeColor">@color/glass_border</item>
        <item name="chipStrokeWidth">@dimen/glass_border_width</item>
        <item name="chipCornerRadius">@dimen/glass_radius_pill</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <!-- Checkable glass chip, used as a segmented control -->
    <style name="Widget.Kamisama.Glass.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/glass_chip_background</item>
        <item name="chipStrokeColor">@color/glass_border</item>
        <item name="chipStrokeWidth">@dimen/glass_border_width</item>
        <item name="chipCornerRadius">@dimen/glass_radius_pill</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/glass_chip_text</item>
        <item name="rippleColor">@color/glass_ripple</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <style name="ShapeAppearance.Kamisama.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Kamisama.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Animation.Kamisama.Screen" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/glass_screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/glass_screen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/glass_screen_return</item>
        <item name="android:activityCloseExitAnimation">@anim/glass_screen_close</item>
    </style>

    <style name="ShapeAppearanceOverlay.Demo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="cornerSize">20dp</item>
        <item name="background">@id/bg</item>
        <item name="cornerFamily">rounded</item>
    </style>
    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="MySnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="android:background">@drawable/round_corner</item>
    </style>
    <string name="MySnackBarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/bg_opp</item>
    </string>
    
    <style name="fontTooltip" parent="Widget.Material3.Tooltip">
        <item name="android:padding">8dp</item>
        <item name="android:textAppearance">@style/Suffix</item>
        <item name="android:layout_margin">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MaterialComponents.Tooltip</item>
    </style>

    <style name="MyPopup" parent="@style/Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_glass_popup</item>
    </style>

    <style name="BottomNavBar" parent="Widget.Material3.BottomNavigationView.ActiveIndicator"/>
</resources>